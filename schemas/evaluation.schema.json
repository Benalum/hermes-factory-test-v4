{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hermes Task Evaluation",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "project",
    "task_id",
    "task_type",
    "role",
    "model",
    "evidence",
    "result",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "timestamp": {
      "type": "string"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "required": [
        "provider",
        "name",
        "selection_reason"
      ],
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "selection_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "estimated_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "attempts",
        "duration_seconds",
        "input_tokens",
        "output_tokens",
        "estimated_cost_usd"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "delivery_pr_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "delivery_head_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "tested_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewed_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "merged_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "ci_check": {
          "type": [
            "string",
            "null"
          ]
        },
        "ci_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "workspace_clean": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "pr_head_matched": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "delivery_pr_url",
        "delivery_head_sha",
        "tested_sha",
        "reviewed_sha",
        "merged_sha",
        "ci_check",
        "ci_passed",
        "workspace_clean",
        "pr_head_matched",
        "sources"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "tests_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tests_passed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reviewer_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "required_rework": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "review_outcome": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "APPROVE",
            "REQUEST_CHANGES",
            "BLOCK",
            null
          ]
        },
        "evidence_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "tests_total",
        "tests_passed",
        "reviewer_score",
        "required_rework",
        "review_outcome",
        "evidence_valid",
        "evidence"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "success",
        "merged",
        "delivery_valid",
        "status"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "merged": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "delivery_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
